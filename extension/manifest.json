{
  "manifest_version": 3,
  "name": "FR Finder",
  "version": "1.4.0",
  "description": "FR Finder by GC Tech: find the most similar frequency responses inside a squig.link database. Unofficial.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://squig.link/*",
        "https://*.squig.link/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://squig.link/*",
        "https://*.squig.link/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}